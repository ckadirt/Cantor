---
/**
 * cantorfm.com. What Cantor is, in the order a stranger needs it: a library
 * that is a map, the shapes it is drawn in, one node shared by many people,
 * your own music beside what you make, privacy by construction, the source,
 * and how to begin. The art is the app's own geometry throughout.
 */
import Site from '../layouts/Site.astro';
import Seal from '../components/art/Seal.astro';
import Face from '../components/art/Face.astro';
import Marbling from '../components/art/Marbling.astro';
import Station from '../components/art/Station.astro';
import Phone from '../components/art/Phone.astro';
import FieldMap from '../components/art/FieldMap.astro';
import CopyLine from '../components/CopyLine.astro';
import { facePathAt } from '../lib/library';
import { recipeOf } from '../lib/art';
import { hash, mulberry32, metadataSeed } from '../../../cantor/src/lenses/face';
import { SITE } from '../site';

const NAME = 'cantorfm.com';
/** The song the lenses draw: any recipe would do; this one reads well. */
const SONG = 'an empty ballroom';

/** One node, many phones: where each mark stands in the diagram, in percent. */
const NODES = [
  { key: 'your desktop', label: 'Your desktop · GPU', x: 56, y: 50, models: 3, big: true },
  { key: 'your laptop', label: 'Your laptop', x: 10, y: 50, models: 1, big: false },
];
const PHONES = [
  { key: 'your phone', label: 'You', x: 32, y: 16, to: ['your desktop', 'your laptop'] },
  { key: 'ana', label: 'Ana', x: 32, y: 84, to: ['your desktop'] },
  { key: 'leo', label: 'Leo', x: 88, y: 18, to: ['your desktop'] },
  { key: 'mia', label: 'Mia', x: 88, y: 82, to: ['your desktop'] },
];
const at = (key: string) => [...NODES, ...PHONES].find((n) => n.key === key)!;
/** Each phone's own few songs, beside it: nobody else's. */
const shelf = (owner: string) =>
  [0, 1, 2].map((i) => ({ ...recipeOf(`${owner} ${i}`), seed: hash(`${owner} ${i}`) }));

/** What the relay carries, drawn as bytes: deterministic, so the page is stable. */
const bytes = (() => {
  const random = mulberry32(0x5ea1ed);
  return Array.from({ length: 10 }, () =>
    Array.from({ length: 16 }, () => Math.floor(random() * 256).toString(16).padStart(2, '0')).join(' '),
  );
})();

const IMPORTED_EXAMPLE = { title: 'Puerto', artist: 'Marisol Vega' };
const importedRecipe = { seed: metadataSeed(IMPORTED_EXAMPLE.title, IMPORTED_EXAMPLE.artist), id: 'device-0-0', model: 'device', durationMs: 214000, imported: true };
const madeRecipe = { ...recipeOf('a slow blues, at dusk') };
---
<Site title="Cantor — songs made on your own machine" description="A music library you can make songs for, on a computer you own. Your phone plays it; nothing in between can listen.">
  <nav class="top" data-nav>
    <a class="brand" href="/"><Seal name={NAME} depth={2} filled class="brand-seal" /><span>Cantor</span></a>
    <span class="links">
      <a href="/docs/">Docs</a>
      <a href={SITE.github}>Source</a>
      <a href="#begin" class="get">Get Cantor</a>
    </span>
  </nav>

  <header class="hero">
    <Marbling name={NAME} live fit={1.9} cx={0.68} cy={0.48} class="bath" label="This site's name, marbled one drop at a time" />
    <div class="title">
      <h1>Cantor</h1>
      <p>Songs made on your own machine,<br />heard on your phone.</p>
    </div>
    <aside class="plate-card">
      <span>Plate I</span>
      <i>cantorfm.com, marbled</i>
      <span>A drop of ink for every bar · bar <b data-bar-for={NAME}>0</b></span>
    </aside>
  </header>

  <section class="statement">
    <p class="big">A music library you can make songs for. The models run on a computer you own, your phone plays what they make, and nothing in between can listen.</p>
  </section>

  <!-- ===== the map ===== -->
  <section class="map">
    <div class="inner side-by-side">
      <div class="words">
        <span class="lab">Your library</span>
        <h2>Every song you have, on one map</h2>
        <p>Not a feed and not a list. Your songs gather by when they arrived, each drawn as its own shape, and you move through them like a place: pinch out to see months, in to open a song.</p>
        <p>How a mark is inked says where the song is, so you can tell at a glance what will play on a plane.</p>
        <ul class="legend">
          <li><svg viewBox="-10 -10 20 20"><path d={facePathAt(madeRecipe, 0, 0, 8)} class="l-remote" /></svg>On your node</li>
          <li><svg viewBox="-10 -10 20 20"><path d={facePathAt(madeRecipe, 0, 0, 8)} class="l-cached" /></svg>Cached on your phone</li>
          <li><svg viewBox="-10 -10 20 20"><path d={facePathAt(madeRecipe, 0, 0, 8)} class="l-down" /></svg>Kept on your phone</li>
          <li><svg viewBox="-10 -10 20 20"><path d={facePathAt(importedRecipe, 0, 0, 8) + 'M1.6 0a1.6 1.6 0 1 0 -3.2 0a1.6 1.6 0 1 0 3.2 0Z'} class="l-down" fill-rule="evenodd" /></svg>Your own file</li>
        </ul>
      </div>
      <FieldMap by="month" label="A library of made and imported songs, gathered by month" />
    </div>
  </section>

  <!-- ===== the lenses ===== -->
  <section class="inverse lenses">
    <div class="inner">
      <header class="split">
        <h2>A song is known by its shape</h2>
        <p>Every song is drawn from its own recipe, three ways. The same song is the same shape on every phone, so you know it before you read its name, even before it has finished being made.</p>
      </header>
      <div class="three">
        <figure>
          <div class="art"><Face name={SONG} class="face" /></div>
          <figcaption><i>The circle</i>One contour: its lobes, its turn, its length.</figcaption>
        </figure>
        <figure>
          <div class="art"><Seal name={SONG} depth={3} played={0} class="looping" /></div>
          <figcaption><i>The seal</i>Each dot a moment of the song, inked as it plays.</figcaption>
        </figure>
        <figure>
          <div class="art"><Marbling name={SONG} class="marble" /></div>
          <figcaption><i>The marbling</i>Drops of ink and clear water, combed. Nothing is erased.</figcaption>
        </figure>
      </div>
      <p class="recipe">“{SONG}”</p>
    </div>
  </section>

  <!-- ===== one node, many people ===== -->
  <section class="network">
    <div class="inner">
      <header class="split">
        <div>
          <span class="lab">Your compute</span>
          <h2>One machine, a whole household</h2>
        </div>
        <p>A node is the computer that makes the songs. Pair your phone with it, and your friends' phones too: each person gets a library of their own on it, which nobody else sees. And one phone can use several nodes, the desktop with the GPU and the laptop on the road.</p>
      </header>
      <figure class="net" aria-label="Four phones paired with one desktop node; one phone also paired with a laptop">
        <svg class="wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {PHONES.flatMap((p) => p.to.map((t) => {
            const n = at(t);
            return <line x1={p.x} y1={p.y} x2={n.x} y2={n.y} />;
          }))}
        </svg>
        {NODES.map((n) => (
          <div class:list={['node', { big: n.big }]} style={`left:${n.x}%;top:${n.y}%`}>
            <Station publicKey={n.key} models={n.models} />
            <span>{n.label}</span>
          </div>
        ))}
        {PHONES.map((p) => (
          <div class="person" style={`left:${p.x}%;top:${p.y}%`}>
            <Phone publicKey={p.key} />
            <span>{p.label}</span>
            <svg class="own" viewBox="-30 -10 60 20" aria-hidden="true">
              {shelf(p.key).map((r, i) => <path d={facePathAt(r, -18 + i * 18, 0, 7)} />)}
            </svg>
          </div>
        ))}
      </figure>
      <dl class="facts">
        <div><dt>Pair once</dt><dd>A phone scans a one-time code from <code>cantor pair</code>. Revoke it whenever you like.</dd></div>
        <div><dt>Separate libraries</dt><dd>Everyone's songs, prompts and uploads are theirs alone, kept apart by the node.</dd></div>
        <div><dt>Fair turns</dt><dd>The node makes one song at a time, in order, and caps how much each phone can queue.</dd></div>
      </dl>
    </div>
  </section>

  <!-- ===== your music, beside what you make ===== -->
  <section class="import">
    <div class="inner">
      <header class="split">
        <div>
          <span class="lab">Your music</span>
          <h2>What you own and what you make, side by side</h2>
        </div>
        <p>Cantor reads the music already on your phone, with its titles, albums, artwork and lyrics, and puts it in the same field as the songs you make. Sort by artist and your records sit beside the models that sang for you.</p>
      </header>
      <div class="side-by-side flip">
        <FieldMap by="artist" label="The same library by artist: made songs grouped by the model that sang them, imported ones by artist" />
        <div class="words">
          <div class="pairing-of-two">
            <figure>
              <svg viewBox="-12 -12 24 24" aria-hidden="true"><path d={facePathAt(madeRecipe, 0, 0, 10)} class="l-cached" /></svg>
              <figcaption><i>“a slow blues, at dusk”</i><span>Made · drawn from its recipe</span></figcaption>
            </figure>
            <figure>
              <svg viewBox="-12 -12 24 24" aria-hidden="true"><path d={facePathAt(importedRecipe, 0, 0, 10) + 'M2 0a2 2 0 1 0 -4 0a2 2 0 1 0 4 0Z'} class="l-down" fill-rule="evenodd" /></svg>
              <figcaption><i>“{IMPORTED_EXAMPLE.title}”, {IMPORTED_EXAMPLE.artist}</i><span>Imported · drawn from its tags, with a hole for the spindle</span></figcaption>
            </figure>
          </div>
          <p class="aside">And any song, made or imported, can start a new one: a version in another style, a longer cut, or something new from a tune you hum.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== privacy ===== -->
  <section class="inverse privacy">
    <div class="inner">
      <header class="split">
        <div>
          <span class="lab">Your privacy</span>
          <h2>No account. Nothing to sign in to.</h2>
        </div>
        <p>Your identity is twelve words made on your phone, not an email on our server. Your phone and your node seal everything between them, end to end. The relay that connects them carries bytes it cannot read.</p>
      </header>
      <div class="sees">
        <figure>
          <span class="lab">What the relay sees</span>
          <pre data-bytes>{bytes.join('\n')}</pre>
          <figcaption>That two devices are talking, when, and how much. Nothing else.</figcaption>
        </figure>
        <figure>
          <span class="lab">What your node reads</span>
          <div class="clear">
            <p><b>make a song</b></p>
            <p>“a slow blues, brushed drums, a voice like smoke”</p>
            <p class="meta">acestep:1.5-fast · 3:00 · from Ana's phone</p>
          </div>
          <figcaption>Only the two ends can open it.</figcaption>
        </figure>
      </div>
      <dl class="facts">
        <div><dt>Keys, not passwords</dt><dd>Ed25519 identities on both sides, pinned when you pair. The node proves itself before your phone says a word.</dd></div>
        <div><dt>Sealed end to end</dt><dd>Noise NK on every connection, with fresh keys each time. No plaintext fallback, ever.</dd></div>
        <div><dt>Nothing reported</dt><dd>The node sends us nothing; its update check goes to GitHub. The app's one other call fetches lyrics for your own files from LRCLIB, which learns a title and an artist, never audio.</dd></div>
      </dl>
    </div>
  </section>

  <!-- ===== the source ===== -->
  <section class="source">
    <div class="inner">
      <header class="split">
        <div>
          <span class="lab">Open source</span>
          <h2>Read every line</h2>
        </div>
        <p>Cantor is Apache-2.0, all of it. You do not have to take our word for anything on this page: the app, the node, the relay and the wire format they share are in one repository.</p>
      </header>
      <ul class="tree">
        <li><a href={`${SITE.github}/tree/main/cantor`}>cantor/</a><span>The Android app: the field, the lenses, the player</span></li>
        <li><a href={`${SITE.github}/tree/main/node`}>node/</a><span>The node, in Rust: models, generation, your library</span></li>
        <li><a href={`${SITE.github}/tree/main/relay`}>relay/</a><span>The relay: a Cloudflare Worker that splices sealed bytes</span></li>
        <li><a href={`${SITE.github}/tree/main/protocol`}>protocol/</a><span>The wire contract, its fixtures, and its generated types</span></li>
        <li><a href={`${SITE.github}/tree/main/contributing`}>contributing/</a><span>How it fits together, and how to change it</span></li>
      </ul>
    </div>
  </section>

  <!-- ===== begin ===== -->
  <section class="inverse begin" id="begin">
    <div class="inner">
      <h2>Begin</h2>
      <div class="two">
        <div class="side">
          <span class="lab">On your phone</span>
          <a class="btn" href={SITE.apk}>Download for Android</a>
          <p>An APK for Android 7 and later.</p>
        </div>
        <div class="side">
          <span class="lab">On your computer</span>
          <CopyLine text={SITE.install} />
          <p>Then <code>cantor pull</code> a model and <code>cantor pair</code> your phone. The installer offers both.</p>
        </div>
      </div>
      <dl class="needs">
        <div><dt>A computer that stays on</dt><dd>Linux or macOS. A GPU makes it quick; a CPU is enough, only slower.</dd></div>
        <div><dt>Room for a model</dt><dd>From about 3 GB for a first model, up to 27 GB for the largest.</dd></div>
        <div><dt>Open models</dt><dd>Good, and yours. Each comes with its own licence, shown before it downloads.</dd></div>
      </dl>
      <a class="more" href="/docs/start/">The quick start, step by step</a>
    </div>
  </section>

  <footer>
    <span class="brand"><Seal name={NAME} depth={2} filled class="brand-seal" />Cantor · alpha</span>
    <span><a href="/docs/">Docs</a><a href={SITE.github}>Source</a><span>Apache-2.0</span></span>
  </footer>
</Site>

<script>
  // The bar turns solid once the hero is behind it, so it never sits on text.
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const hero = document.querySelector('.hero')!;
  new IntersectionObserver(([entry]) => nav.classList.toggle('solid', !entry.isIntersecting), {
    rootMargin: '-64px 0px 0px 0px',
  }).observe(hero);

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The seal plays its song: one dot after another on a linear clock, a rest
  // when it is all ink, then again. Still when motion is reduced.
  for (const seal of document.querySelectorAll<SVGElement>('svg.looping')) {
    const dots = [...seal.querySelectorAll<SVGCircleElement>('circle')];
    const count = dots.length;
    if (still) {
      dots.forEach((d) => d.classList.add('on'));
      continue;
    }
    const PLAY = 14000;
    const REST = 2400;
    let shown = -1;
    let visible = false;
    const start = performance.now();
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(seal);
    const frame = (now: number) => {
      requestAnimationFrame(frame);
      if (!visible) return;
      const t = (now - start) % (PLAY + REST);
      const sounded = Math.min(count, Math.floor((t / PLAY) * count));
      if (sounded === shown) return;
      shown = sounded;
      for (const d of dots) d.classList.toggle('on', Number(d.dataset.k) < sounded);
    };
    requestAnimationFrame(frame);
  }

  // The relay's view keeps moving: a new line of sealed bytes every beat.
  const pre = document.querySelector<HTMLElement>('[data-bytes]');
  if (pre && !still) {
    let visible = false;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(pre);
    const line = () =>
      Array.from({ length: 16 }, () => Math.floor(Math.random() * 256).toString(16).padStart(2, '0')).join(' ');
    setInterval(() => {
      if (!visible) return;
      const lines = pre.textContent!.split('\n');
      lines.shift();
      lines.push(line());
      pre.textContent = lines.join('\n');
    }, 420);
  }
</script>

<style>
  .inner { max-width: 1240px; margin: 0 auto; }
  section { padding: 160px 40px; }
  h2 { font: 400 clamp(38px, 4.2vw, 60px) / 1.05 var(--display); margin: 0; letter-spacing: -0.4px; text-wrap: balance; }
  p { font-size: 19px; line-height: 31px; margin: 0; text-wrap: pretty; }
  .lab { display: block; font: 10.5px/1 var(--mono); letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin-bottom: 22px; }
  .more { display: inline-block; font: 11px/1 var(--mono); letter-spacing: 2px; text-transform: uppercase; text-decoration: none; padding-bottom: 5px; border-bottom: 1px solid currentColor; }
  code { font-size: 0.86em; }

  /* A section's head: the claim on the left, what it means on the right. */
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 60px; align-items: end; margin-bottom: 88px; }
  .split p { color: var(--muted); max-width: 46ch; }

  /* Three short facts on one rule. */
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; margin: 88px 0 0; border-top: 1px solid var(--ink); }
  .facts div { padding-top: 22px; }
  .facts dt { font: 10.5px/1 var(--mono); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 14px; }
  .facts dd { margin: 0; font-size: 16.5px; line-height: 26px; color: var(--muted); max-width: 34ch; }

  /* ---- the bar ------------------------------------------------------------ */
  .top { position: fixed; z-index: 5; inset: 0 0 auto; height: 64px; display: flex; justify-content: space-between; align-items: center; padding: 0 40px;
    font: 11px/1 var(--mono); letter-spacing: 2.4px; text-transform: uppercase; color: var(--ink);
    border-bottom: 1px solid transparent; transition: background-color 0.3s linear, border-color 0.3s linear; }
  .top.solid { background: var(--paper); border-bottom-color: var(--line); }
  .top a { text-decoration: none; }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand :global(.brand-seal) { width: 19px; height: 19px; --seal-ink: currentColor; }
  .links a { margin-left: 28px; color: var(--muted); transition: color 0.2s linear; }
  .links a:hover { color: var(--ink); }
  .links .get { color: var(--ink); border-bottom: 1px solid var(--ink); padding-bottom: 4px; }

  /* ---- the hero ------------------------------------------------------------- */
  .hero { position: relative; height: 100svh; min-height: 640px; overflow: hidden; }
  .hero :global(.bath) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .title { position: absolute; left: 40px; bottom: 48px; }
  h1 { font: 400 clamp(96px, 15.5vw, 240px) / 0.8 var(--display); margin: 0 0 0 -0.04em; letter-spacing: -0.02em; }
  .title p { font: 400 clamp(20px, 1.9vw, 27px) / 1.3 var(--display); color: var(--muted); margin: 28px 0 0; }
  .plate-card { position: absolute; right: 40px; bottom: 52px; display: grid; justify-items: end; gap: 7px; text-align: right;
    font: 10px/1.4 var(--mono); letter-spacing: 1.6px; text-transform: uppercase; color: var(--muted); }
  .plate-card i { font: italic 400 17px/1.2 var(--display); letter-spacing: 0; text-transform: none; color: var(--ink); }
  .plate-card b { font-weight: 400; color: var(--ink); font-variant-numeric: tabular-nums; }

  /* ---- what it is ------------------------------------------------------------ */
  .statement { max-width: 1320px; margin: 0 auto; padding-top: 180px; padding-bottom: 60px; }
  .big { font: 400 clamp(32px, 3.4vw, 50px) / 1.18 var(--display); letter-spacing: -0.2px; max-width: 30ch; text-wrap: balance; }

  /* Words on one side, a phone's screen on the other. */
  .side-by-side { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 420px); gap: 96px; align-items: center; }
  .side-by-side.flip { grid-template-columns: minmax(0, 420px) minmax(0, 1fr); }
  .side-by-side .words p { color: var(--muted); max-width: 44ch; margin-top: 24px; }
  .side-by-side .words h2 { max-width: 14ch; }

  /* ---- the map --------------------------------------------------------------- */
  .legend { list-style: none; padding: 0; margin: 44px 0 0; display: grid; gap: 16px;
    font: 10.5px/1 var(--mono); letter-spacing: 1.4px; text-transform: uppercase; color: var(--muted); }
  .legend li { display: flex; align-items: center; gap: 12px; }
  .legend svg { width: 20px; height: 20px; }
  .l-remote { fill: none; stroke: var(--faint); stroke-width: 1px; vector-effect: non-scaling-stroke; }
  .l-cached { fill: none; stroke: var(--ink); stroke-width: 1px; vector-effect: non-scaling-stroke; }
  .l-down { fill: var(--ink); stroke: var(--ink); stroke-width: 1px; vector-effect: non-scaling-stroke; }

  /* ---- the lenses ------------------------------------------------------------ */
  .three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; }
  .three figure { margin: 0; }
  .art { aspect-ratio: 1 / 1; display: grid; place-items: center; }
  .art :global(.face) { width: 78%; height: 78%; }
  .art :global(.face path) { stroke-width: 1.4px; }
  .art :global(.looping) { width: 66%; height: 66%; }
  .art :global(.marble) { width: 74%; height: 74%; }
  .three figcaption { margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--line); font-size: 15.5px; line-height: 24px; color: var(--muted); max-width: 30ch; }
  .three figcaption i { display: block; font: italic 400 22px/1.2 var(--display); color: var(--ink); margin-bottom: 6px; }
  .recipe { margin-top: 72px; text-align: center; font: italic 400 20px/1 var(--display); color: var(--muted); }

  /* ---- the network ----------------------------------------------------------- */
  .net { position: relative; margin: 0; aspect-ratio: 2.4 / 1; }
  .net .wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .net .wires line { stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-dasharray: 0 9; vector-effect: non-scaling-stroke; animation: flow 1.8s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -9; } }
  .node, .person { position: absolute; transform: translate(-50%, -50%); display: grid; justify-items: center; gap: 12px; background: var(--paper); padding: 10px; }
  .node :global(svg) { width: 64px; height: 64px; }
  .node.big :global(svg) { width: 104px; height: 104px; }
  .person > :global(svg.phone) { width: 52px; height: 52px; }
  .node span, .person span { font: 10px/1 var(--mono); letter-spacing: 1.8px; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .node.big span { color: var(--ink); }
  .person .own { width: 66px; height: 22px; }
  .person .own path { fill: none; stroke: var(--ink); stroke-width: 1px; vector-effect: non-scaling-stroke; }
  @media (prefers-reduced-motion: reduce) { .net .wires line { animation: none; } }

  /* ---- import ---------------------------------------------------------------- */
  .pairing-of-two { display: grid; gap: 36px; margin: 0 0 44px; }
  .pairing-of-two figure { margin: 0; display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 26px; align-items: center; }
  .pairing-of-two svg { width: 96px; height: 96px; }
  .pairing-of-two figcaption i { display: block; font: italic 400 22px/1.25 var(--display); }
  .pairing-of-two figcaption span { display: block; margin-top: 8px; font: 10.5px/1.5 var(--mono); letter-spacing: 1.4px; text-transform: uppercase; color: var(--muted); }
  .import .aside { color: var(--muted); max-width: 44ch; }

