---
/**
 * cantorfm.com, told as one scroll. A song's shape, which morphs as the song
 * changes; the library that floats round it gathers into a map, and the map
 * plays — regathering, changing lens, its inks filling; the camera falls into
 * a song and the page goes to ink: twelve words instead of an account, then
 * the wire from a phone through the relay to a node, sealed, and the
 * household one node can serve; then the source, and how to begin.
 *
 * The stages are `scripts/field-stage.ts` and `scripts/privacy-stage.ts`;
 * every shape is the app's.
 */
import { execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Site from '../layouts/Site.astro';
import Seal from '../components/art/Seal.astro';
import Device from '../components/art/Device.astro';
import CopyLine from '../components/CopyLine.astro';
import { facePathAt, sampleLibrary } from '../lib/library';
import { recipeOf, clock } from '../lib/art';
import { phraseGeometry } from '../lib/phrase';
import { hash, mulberry32 } from '../../../cantor/src/lenses/face';
import { AXES, BEATS, FIELD_RUN_VH, LENSES, SPECIMENS } from '../scripts/field-stage';
import { PRIVACY, PRIVACY_RUN_VH } from '../scripts/privacy-stage';
import { SITE } from '../site';

const NAME = 'cantorfm.com';
/** The song the story follows: it opens the page and the camera falls into it. */
const HERO = 'an empty ballroom';
/** The repository, from the site's root: the build runs from docs/. */
const REPO = resolve(process.cwd(), '..');

const songs = sampleLibrary();
const songOf = (title: string) => songs.find((s) => s.title === title)!;
/** The shapes the first beat morphs through, each with what its card prints. */
const specimens = SPECIMENS.map((title) => {
  const s = songOf(title);
  return {
    title,
    model: s.byline,
    length: clock(s.recipe.durationMs / 1000),
    seed: (s.recipe.seed ?? 0).toString(16).padStart(8, '0'),
    thumb: facePathAt(s.recipe, 0, 0, 9),
  };
});

/**
 * A real BIP39 phrase, the kind the app mints, from fixed entropy so it is
 * nobody's: 128 bits, then the first 4 bits of their SHA-256, read as twelve
 * 11-bit indexes into the wordlist.
 */
const WORDLIST: string[] = (
  /`([^`]*)`/.exec(readFileSync(resolve(REPO, 'cantor/node_modules/@scure/bip39/wordlists/english.js'), 'utf8'))?.[1] ?? ''
).split('\n').map((w) => w.trim()).filter(Boolean);
const words = (() => {
  const random = mulberry32(0xb1739);
  const entropy = Buffer.from(Array.from({ length: 16 }, () => Math.floor(random() * 256)));
  const check = createHash('sha256').update(entropy).digest()[0] >> 4;
  const bits = [...entropy].map((b) => b.toString(2).padStart(8, '0')).join('') + check.toString(2).padStart(4, '0');
  return Array.from({ length: 12 }, (_, i) => WORDLIST[parseInt(bits.slice(i * 11, i * 11 + 11), 2)]);
})();
/**
 * The reveal's glyphs: each word as the 11 bits it encodes, its index in the
 * wordlist (the app's `wordBits`), and as itself, in the site's display face.
 */
const slots = phraseGeometry(
  resolve(REPO, 'cantor/assets/fonts/cmu-serif.ttf'),
  words.map((word) => ({ word, bits: WORDLIST.indexOf(word).toString(2).padStart(11, '0') })),
);

const PROMPT = 'a slow blues, brushed drums, a voice like smoke';

/** The wire, in percent of its figure; the relay stands in the middle. */
const NODES = [
  { key: 'desktop', label: 'Your desktop · GPU', x: 88, y: 50, models: 3, step: 0 },
  { key: 'laptop', label: 'Your laptop', x: 88, y: 13, models: 1, step: 2 },
] as const;
const PHONES = [
  { key: 'you', label: 'Your phone', x: 8, y: 50, step: 0 },
  { key: 'ana', label: 'Ana’s phone', x: 8, y: 13, step: 1 },
  { key: 'leo', label: 'Leo’s phone', x: 8, y: 87, step: 1 },
];
/** Who talks to whom, and from which step: 0 sealed, 1 the household, 2 roaming. */
const LINKS: [string, string, number][] = [['you', 'desktop', 0], ['ana', 'desktop', 1], ['leo', 'desktop', 1], ['you', 'laptop', 2]];
const shelf = (owner: string) => [0, 1, 2].map((i) => ({ ...recipeOf(`${owner} ${i}`), seed: hash(`${owner} ${i}`) }));

/** Each part of the repository, and the languages git says it is written in. */
const LANGS: Record<string, string> = { ts: 'TypeScript', tsx: 'TypeScript', kt: 'Kotlin', java: 'Java', rs: 'Rust', mjs: 'JavaScript', md: 'Markdown', sh: 'Shell', py: 'Python' };
function languages(dir: string) {
  try {
    const files = execFileSync('git', ['ls-files', dir], { cwd: REPO, encoding: 'utf8' }).split('\n').filter(Boolean);
    const by = new Map<string, number>();
    for (const file of files) {
      const lang = LANGS[file.split('.').pop() ?? ''];
      if (lang) by.set(lang, (by.get(lang) ?? 0) + readFileSync(resolve(REPO, file), 'utf8').split('\n').length);
    }
    return [...by].sort((a, b) => b[1] - a[1]).slice(0, 2).map(([l]) => l);
  } catch {
    // Built outside a checkout: the folders still read, without their languages.
    return [];
  }
}
const TREE = [
  ['cantor', 'The Android app: the field, the lenses, the player'],
  ['node', 'The node: models, generation, your library'],
  ['relay', 'The relay: it passes sealed bytes between phone and node'],
  ['protocol', 'The wire contract, its fixtures, its generated types'],
  ['contributing', 'How it fits together, and how to change it'],
].map(([dir, what]) => ({ dir, what, langs: languages(dir) }));

/**
 * The function that draws every circle on this page, quoted from the app, and
 * the lines the live trace writes its values beside.
 */
const FACE_FILE = 'cantor/src/lenses/face.ts';
const faceLines = readFileSync(resolve(REPO, FACE_FILE), 'utf8').split('\n');
const quoteFrom = faceLines.findIndex((l) => l.startsWith('function contourPoint'));
const quoteTo = faceLines.findIndex((l, i) => i > quoteFrom && l === '}');
const NOTES: [RegExp, string][] = [[/^function contourPoint/, 'angle'], [/= params;$/, 'params'], [/\+ 1\.1\);$/, 'radius'], [/x: Math\.cos/, 'x'], [/y: \(Math\.sin/, 'y']];
const quoted = faceLines.slice(quoteFrom, quoteTo + 1).map((text, i) => ({
  n: quoteFrom + i + 1,
  text,
  note: NOTES.find(([re]) => re.test(text.trim()))?.[1],
}));
---
<Site title="Cantor: songs made on your own machine" description="A music library you can make songs for, on a computer you own. Your phone plays it; nothing in between can listen.">
  <nav class="top" data-nav>
    <a class="brand" href="/"><Seal name={NAME} depth={2} filled class="brand-seal" /><span>Cantor</span></a>
    <span class="links">
      <a href="/docs/">Docs</a>
      <a href={SITE.github}>Source</a>
      <a href="#begin" class="get">Get Cantor</a>
    </span>
  </nav>

  <ol class="rail" aria-label="Chapters">
    <li><a href="#field" data-chapter="field">The field</a></li>
    <li><a href="#privacy" data-chapter="privacy">Privacy</a></li>
    <li><a href="#network" data-chapter="network">Sharing</a></li>
    <li><a href="#source" data-chapter="source">Source</a></li>
    <li><a href="#begin" data-chapter="begin">Begin</a></li>
  </ol>

  <!-- ===== the field: one pinned stage ===== -->
  <section class="stage field" id="field" data-stage="field" style={`height:${FIELD_RUN_VH + 100}vh`}>
    <div class="pin">
      <canvas class="canvas" data-field-canvas aria-hidden="true"></canvas>
      <div class="tip" data-stage-tip hidden><i></i><span></span></div>

      <div class="beat hero-beat" data-beat={`0 ${BEATS.shape - 0.01}`}>
        <h1 aria-label="Cantor">{[...'Cantor'].map((ch, i) => <span style={`--i:${i}`} aria-hidden="true">{ch}</span>)}</h1>
        <p class="rise">Songs made on your own machine,<br />heard on your phone.</p>
        <div class="cta">
          <a class="btn" href={SITE.apk}>Download for Android</a>
          <div class="cta-node">
            <span class="lab">Then, on your computer</span>
            <CopyLine text={SITE.install} />
          </div>
        </div>
      </div>

      <div class="specimen beat" data-beat={`0 ${BEATS.gather}`} data-specimen>
        <div class="spec-lines">
          {specimens.map((s, i) => (
            <p data-spec={i}><i>“{s.title}”</i><span>{s.length} · {s.model} · seed {s.seed}</span></p>
          ))}
        </div>
        <ol class="strip" aria-label="Songs">
          {specimens.map((s, i) => (
            <li><button type="button" data-thumb={i} aria-label={`“${s.title}”`}><svg viewBox="-10 -10 20 20" aria-hidden="true"><path d={s.thumb} /></svg></button></li>
          ))}
        </ol>
      </div>
      <p class="cue beat" data-beat={`0 ${BEATS.shape / 2}`}>Scroll</p>

      <div class="beat words" data-beat={`${BEATS.shape} ${BEATS.gather}`}>
        <span class="lab">01 · A song</span>
        <h2>Every song has a shape.</h2>
        <p>Drawn from its recipe: its seed, its model, its length. The same on every phone, before the song has even finished being made.</p>
      </div>
      <div class="beat words" data-beat={`${BEATS.gather} ${BEATS.dive[0]}`}>
        <span class="lab">02 · A library</span>
        <h2>Together, they make a map.</h2>
        <p>What your node makes and the music already on your phone, in one field.</p>
        <div class="controls">
          <div><span>Gather by</span>{AXES.map((a, i) => <button type="button" data-axis={i}>{a}</button>)}</div>
          <div><span>Lens</span>{LENSES.map((l, i) => <button type="button" data-lens={i}>{l}</button>)}</div>
        </div>
      </div>
      <div class="beat words dive-words" data-beat={`${BEATS.dive[0] + 0.02} ${BEATS.dive[1]}`}>
        <span class="lab">03 · Yours</span>
        <h2>Made on a machine you own.</h2>
      </div>

      <div class="night" data-night aria-hidden="true"></div>
      <div class="progress" aria-hidden="true"><i data-field-progress></i></div>
    </div>
  </section>

  <!-- ===== privacy and sharing: pinned, in ink ===== -->
  <section class="stage inverse privacy" id="privacy" data-stage="privacy" style={`height:${PRIVACY_RUN_VH + 100}vh`}>
    <span class="anchor" id="network" aria-hidden="true" style={`top:${(PRIVACY.household + 0.01) * PRIVACY_RUN_VH}vh`}></span>
    <div class="pin">
      <div class="beat words" data-beat={`0 ${PRIVACY.words[1]}`}>
        <span class="lab">04 · No account</span>
        <h2>Nothing to sign in to.</h2>
        <p>Your identity is twelve words your phone makes for itself. No email, no password, nothing of yours on our side.</p>
      </div>
      <figure class="phrase beat" data-beat={`0 ${PRIVACY.words[1]}`} data-phrase aria-label={`Twelve words: ${words.join(' ')}`}>
        <canvas aria-hidden="true"></canvas>
        <script is:inline type="application/json" set:html={JSON.stringify(slots)}></script>
        <figcaption>Each word is the 11 bits it stands for: 128 drawn at random on your phone, and 4 that check them.</figcaption>
      </figure>

      <div class="beat words" data-beat={`${PRIVACY.wire[0]} ${PRIVACY.household}`}>
        <span class="lab">05 · End to end</span>
        <h2>Sealed, the whole way.</h2>
        <p>Your phone and your node meet through a relay. It carries bytes it cannot open: it sees that two devices talk, never what they say.</p>
      </div>
      <div class="beat words" data-beat={`${PRIVACY.household} ${PRIVACY.roaming}`}>
        <span class="lab">06 · Your compute</span>
        <h2>One machine, a whole household.</h2>
        <p>The computer with the GPU makes the songs, for your phone and your friends'. Each keeps a library of its own on the node, which nobody else sees.</p>
      </div>
      <div class="beat words" data-beat={`${PRIVACY.roaming} ${PRIVACY.wire[1]}`}>
        <span class="lab">07 · And back</span>
        <h2>One phone, many nodes.</h2>
        <p>The desktop at home, the laptop on the road. Pair with any of them; revoke any of them whenever you like.</p>
      </div>

      <figure class="wire beat" data-beat={`${PRIVACY.wire[0]} ${PRIVACY.wire[1]}`} data-wire data-links={JSON.stringify(LINKS)}
        aria-label="A phone talks to a node through the relay, which sees only sealed bytes; then two more phones share the node, and the first phone pairs with a laptop too">
        <canvas aria-hidden="true"></canvas>
        <div class="end relay" data-end="relay" style="left:50%;top:50%">
          <Device kind="cloud" />
          <span>The relay</span>
        </div>
        {NODES.map((n) => (
          <div class="end node" data-end={n.key} data-step={n.step} style={`left:${n.x}%;top:${n.y}%`}>
            <Device kind={n.key} publicKey={`your ${n.key}`} models={n.models} />
            <span>{n.label}</span>
          </div>
        ))}
        {PHONES.map((p) => (
          <div class="end person" data-end={p.key} data-step={p.step} style={`left:${p.x}%;top:${p.y}%`}>
            <Device kind="phone" publicKey={p.key === 'you' ? 'your phone' : p.key} />
            <span>{p.label}</span>
            <svg class="own" viewBox="-30 -10 60 20" aria-hidden="true">
              {shelf(p.key).map((r, i) => <path d={facePathAt(r, -18 + i * 18, 0, 7)} />)}
            </svg>
          </div>
        ))}
        <p class="say say-plain"><span>Your phone writes</span><i data-plain={PROMPT}></i></p>
        <p class="say say-sealed"><span>The relay sees</span><code data-sealed></code></p>
        <p class="say say-read"><span>Your node reads</span><i data-read></i></p>
      </figure>
    </div>
  </section>

  <!-- ===== the source ===== -->
  <section class="source" id="source">
    <div class="inner">
      <header class="split">
        <div>
          <span class="lab">08 · Open source</span>
          <h2>Read every line.</h2>
        </div>
        <p>Cantor is Apache-2.0, all of it. You do not have to take our word for anything on this page: the app, the node, the relay and the wire format they share are in one repository.</p>
      </header>
      <div class="trace" data-trace>
        <figure class="listing">
          <figcaption>
            <a href={`${SITE.github}/blob/main/${FACE_FILE}#L${quoted[0].n}-L${quoted[quoted.length - 1].n}`}>{FACE_FILE}</a>
            <span>Every circle on this page</span>
          </figcaption>
          <pre>{quoted.map((l) => (
            <span class:list={['ln', { live: l.note }]}><b>{l.n}</b>{l.text}{l.note && (l.text.length > 56 ? <>{'\n'}<em class="below" data-note={l.note}></em></> : <em data-note={l.note}></em>)}{'\n'}</span>
          ))}</pre>
        </figure>
        <figure class="drawing">
          <canvas aria-hidden="true"></canvas>
          <figcaption><i data-trace-title>“{HERO}”</i></figcaption>
        </figure>
      </div>
      <ul class="repo">
        {TREE.map((t) => (
          <li>
            <a href={`${SITE.github}/tree/main/${t.dir}`}>{t.dir}/</a>
            <span>{t.what}</span>
            {t.langs.length > 0 && <small>{t.langs.join(' · ')}</small>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== begin ===== -->
  <section class="inverse begin" id="begin">
    <div class="inner">
      <h2>Begin</h2>
      <div class="two">
        <div class="side">
          <span class="lab">On your phone</span>
          <a class="btn" href={SITE.apk}>Download for Android</a>
          <p>An APK for Android 7 and later.</p>
        </div>
        <div class="side">
          <span class="lab">On your computer</span>
          <CopyLine text={SITE.install} />
          <p>Then <code>cantor pull</code> a model and <code>cantor pair</code> your phone. The installer offers both.</p>
        </div>
      </div>
      <dl class="needs">
        <div><dt>A computer that stays on</dt><dd>Linux or macOS. A GPU makes it quick; a CPU is enough, only slower.</dd></div>
        <div><dt>Room for a model</dt><dd>From about 3 GB for a first model, up to 27 GB for the largest.</dd></div>
        <div><dt>Open models</dt><dd>Good, and yours. Each comes with its own licence, shown before it downloads.</dd></div>
      </dl>
      <a class="more" href="/docs/start/">The quick start, step by step</a>
    </div>
  </section>

  <footer>
    <span class="brand"><Seal name={NAME} depth={2} filled class="brand-seal" />Cantor · alpha</span>
    <span><a href="/docs/">Docs</a><a href={SITE.github}>Source</a><span>Apache-2.0</span></span>
  </footer>
</Site>

<script>
  import Lenis from 'lenis';
  import { startFieldStage, BEATS } from '../scripts/field-stage';
  import { startPrivacyStage } from '../scripts/privacy-stage';
  import { startSourceStage } from '../scripts/source-stage';

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));

  // Smooth, weighted scrolling; native scrolling when motion is reduced.
  if (!still) new Lenis({ autoRaf: true, lerp: 0.09, anchors: true });

  /** How far through its pinned run a stage is, 0 to 1. */
  const progressOf = (stage: HTMLElement) => {
    const r = stage.getBoundingClientRect();
    return clamp(-r.top / Math.max(1, r.height - innerHeight));
  };

  /** Show each beat in its window, rising in and lifting out. */
  const beats = (stage: HTMLElement, p: number) => {
    for (const beat of stage.querySelectorAll<HTMLElement>('[data-beat]')) {
      const [a, b] = beat.dataset.beat!.split(' ').map(Number);
      const fade = 0.025;
      const inn = a === 0 ? 1 : clamp((p - a) / fade);
      const out = b > 1 ? 1 : clamp((b - p) / fade);
      const o = Math.min(inn, out);
      beat.style.opacity = String(o);
      beat.style.translate = `0 ${(1 - inn) * 28 - (1 - out) * 28}px`;
      beat.style.visibility = o > 0.001 ? 'visible' : 'hidden';
    }
  };

  // ---- the field
  const field = document.querySelector<HTMLElement>('[data-stage="field"]')!;
  const night = field.querySelector<HTMLElement>('[data-night]')!;
  const bar = field.querySelector<HTMLElement>('[data-field-progress]')!;
  const specimen = field.querySelector<HTMLElement>('[data-specimen]')!;
  const specLines = [...specimen.querySelectorAll<HTMLElement>('[data-spec]')];
  const thumbs = [...specimen.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
  const axisButtons = [...field.querySelectorAll<HTMLButtonElement>('[data-axis]')];
  const lensButtons = [...field.querySelectorAll<HTMLButtonElement>('[data-lens]')];
  const stage = startFieldStage(
    field.querySelector('[data-field-canvas]')!,
    field,
    'an empty ballroom',
    (p) => {
      beats(field, p);
      // The page goes to ink as the dive ends.
      const dusk = BEATS.dive[1] - 0.04;
      night.style.opacity = String(clamp((p - dusk) / (1 - dusk)));
      bar.style.transform = `scaleX(${p})`;
      specimen.classList.toggle('strip-on', p > BEATS.shape - 0.01);
    },
    (mode) => {
      axisButtons.forEach((b, i) => b.setAttribute('aria-pressed', String(i === mode.axis)));
      lensButtons.forEach((b, i) => b.setAttribute('aria-pressed', String(i === mode.lens)));
    },
    ({ index, from, t }) => {
      // The card under the shape names whichever song it is becoming.
      // One name leaves before the next arrives, so they never overprint.
      const settled = t >= 1 || from === index;
      const out = settled ? 1 : Math.min(1, t * 2);
      const inn = settled ? 1 : Math.max(0, t * 2 - 1);
      specLines.forEach((el, k) => {
        el.style.opacity = String(k === index ? inn : k === from ? 1 - out : 0);
        el.style.translate = `0 ${k === index ? (1 - inn) * 8 : k === from ? -out * 8 : 0}px`;
      });
      thumbs.forEach((el, k) => el.setAttribute('aria-pressed', String(k === (t < 0.5 && !settled ? from : index))));
    },
  );
  thumbs.forEach((b, i) => b.addEventListener('click', () => stage.setSpecimen(i)));
  axisButtons.forEach((b, i) => b.addEventListener('click', () => stage.setAxis(i)));
  lensButtons.forEach((b, i) => b.addEventListener('click', () => stage.setLens(i)));

  // ---- privacy and sharing
  const privacy = document.querySelector<HTMLElement>('[data-stage="privacy"]')!;
  startPrivacyStage(privacy, () => progressOf(privacy));
  const frame = () => {
    requestAnimationFrame(frame);
    beats(privacy, progressOf(privacy));
  };
  requestAnimationFrame(frame);

  // ---- the source: its own function, drawing
  startSourceStage(document.querySelector<HTMLElement>('#source')!);

  // ---- the bar and the rail
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-chapter]')];
  const chrome = () => {
    const onInk = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      return r.top < 32 && r.bottom > 32;
    };
    const fieldR = field.getBoundingClientRect();
    const dark = onInk(privacy) || onInk(document.getElementById('begin')!) || (fieldR.bottom > 32 && progressOf(field) > BEATS.dive[1] - 0.02);
    nav.classList.toggle('on-ink', dark);
    nav.classList.toggle('solid', !dark && !(fieldR.top <= 0 && fieldR.bottom > innerHeight));
    let current = links[0];
    for (const a of links) {
      const target = document.getElementById(a.dataset.chapter!);
      if (target && target.getBoundingClientRect().top < innerHeight * 0.5) current = a;
    }
    for (const a of links) a.classList.toggle('on', a === current);
    requestAnimationFrame(chrome);
  };
  requestAnimationFrame(chrome);
</script>

<style is:global>
  html.lenis, html.lenis body { height: auto; }
  .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
</style>

<style>
  /* Clear of the chapter rail on the right. */
  .inner { max-width: min(1240px, calc(100vw - 320px)); margin: 0 auto; }
  section { padding: 160px 40px; }
  h2 { font: 400 clamp(40px, 4.6vw, 68px) / 1.02 var(--display); margin: 0; letter-spacing: -0.5px; text-wrap: balance; }
  p { font-size: 19px; line-height: 31px; margin: 0; text-wrap: pretty; }
  .lab { display: block; font: 10.5px/1 var(--mono); letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin-bottom: 22px; }
  .more { display: inline-block; font: 11px/1 var(--mono); letter-spacing: 2px; text-transform: uppercase; text-decoration: none; padding-bottom: 5px; border-bottom: 1px solid currentColor; }
  code { font-size: 0.86em; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 60px; align-items: end; margin-bottom: 88px; }
  .split p { color: var(--muted); max-width: 46ch; }
  .btn { justify-self: start; font: 400 24px/1 var(--display); padding: 20px 30px; background: var(--ink); color: var(--paper); text-decoration: none; transition: opacity 0.2s linear; white-space: nowrap; }
  .btn:hover { opacity: 0.85; }

  /* ---- the bar and the rail ----------------------------------------------- */
  .top { position: fixed; z-index: 6; inset: 0 0 auto; height: 64px; display: flex; justify-content: space-between; align-items: center; padding: 0 40px;
    font: 11px/1 var(--mono); letter-spacing: 2.4px; text-transform: uppercase; color: var(--ink);
