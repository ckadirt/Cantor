---
/**
 * cantorfm.com, told as one scroll. A song's shape becomes a library; the
 * library changes lens; the camera falls into a song and the page goes to
 * ink, where privacy is shown rather than promised; then one node is shared
 * by a household; then the source, and how to begin.
 *
 * The field stage is `scripts/field-stage.ts`; every shape is the app's.
 */
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Site from '../layouts/Site.astro';
import Seal from '../components/art/Seal.astro';
import Station from '../components/art/Station.astro';
import Phone from '../components/art/Phone.astro';
import CopyLine from '../components/CopyLine.astro';
import { facePathAt } from '../lib/library';
import { recipeOf } from '../lib/art';
import { hash, metadataSeed, mulberry32 } from '../../../cantor/src/lenses/face';
import { SITE } from '../site';

const NAME = 'cantorfm.com';
/** The song the story follows: it opens the page and the camera falls into it. */
const HERO = 'an empty ballroom';

/** Twelve real BIP39 words, the kind of phrase the app makes; not anyone's. */
const WORDLIST: string[] = (
  /`([^`]*)`/.exec(
    // Resolved from the site's root: the build runs from docs/.
    readFileSync(resolve(process.cwd(), '../cantor/node_modules/@scure/bip39/wordlists/english.js'), 'utf8'),
  )?.[1] ?? ''
).split('\n').map((w) => w.trim()).filter(Boolean);
const words = (() => {
  const random = mulberry32(0xb1739);
  return Array.from({ length: 12 }, () => WORDLIST[Math.floor(random() * WORDLIST.length)] ?? '');
})();

const PROMPT = 'a slow blues, brushed drums, a voice like smoke';

/** The household: where each mark stands in the diagram, in percent, and when it pairs. */
const NODES = [
  { key: 'your desktop', label: 'Your desktop · GPU', x: 56, y: 50, models: 3, big: true, step: 0 },
  { key: 'your laptop', label: 'Your laptop', x: 10, y: 50, models: 1, big: false, step: 5 },
];
const PHONES = [
  { key: 'your phone', label: 'You', x: 32, y: 16, to: [['your desktop', 1], ['your laptop', 5]] },
  { key: 'ana', label: 'Ana', x: 32, y: 84, to: [['your desktop', 2]] },
  { key: 'leo', label: 'Leo', x: 88, y: 18, to: [['your desktop', 3]] },
  { key: 'mia', label: 'Mia', x: 88, y: 82, to: [['your desktop', 4]] },
] as const;
const at = (key: string) => [...NODES, ...PHONES].find((n) => n.key === key)!;
const shelf = (owner: string) => [0, 1, 2].map((i) => ({ ...recipeOf(`${owner} ${i}`), seed: hash(`${owner} ${i}`) }));
const madeRecipe = recipeOf('a slow blues, at dusk');
const importedRecipe = { seed: metadataSeed('Puerto', 'Marisol Vega'), id: 'device-0-0', model: 'device', durationMs: 214000, imported: true };
---
<Site title="Cantor — songs made on your own machine" description="A music library you can make songs for, on a computer you own. Your phone plays it; nothing in between can listen.">
  <nav class="top" data-nav>
    <a class="brand" href="/"><Seal name={NAME} depth={2} filled class="brand-seal" /><span>Cantor</span></a>
    <span class="links">
      <a href="/docs/">Docs</a>
      <a href={SITE.github}>Source</a>
      <a href="#begin" class="get">Get Cantor</a>
    </span>
  </nav>

  <ol class="rail" aria-label="Chapters">
    <li><a href="#field" data-chapter="field">The field</a></li>
    <li><a href="#privacy" data-chapter="privacy">Privacy</a></li>
    <li><a href="#network" data-chapter="network">Sharing</a></li>
    <li><a href="#source" data-chapter="source">Source</a></li>
    <li><a href="#begin" data-chapter="begin">Begin</a></li>
  </ol>

  <!-- ===== the field: one pinned stage ===== -->
  <section class="stage field" id="field" data-stage="field">
    <div class="pin">
      <canvas class="canvas" data-field-canvas aria-hidden="true"></canvas>
      <div class="tip" data-stage-tip hidden><i></i><span></span></div>

      <div class="beat hero-beat" data-beat="0 0.05">
        <h1 aria-label="Cantor">{[...'Cantor'].map((ch, i) => <span style={`--i:${i}`} aria-hidden="true">{ch}</span>)}</h1>
        <p class="rise">Songs made on your own machine,<br />heard on your phone.</p>
      </div>
      <div class="hero-card beat" data-beat="0 0.05">
        <span>Plate I</span><i>“{HERO}”</i><span>made with acestep:1.5-fast</span>
      </div>
      <p class="cue beat" data-beat="0 0.03">Scroll</p>

      <div class="beat words" data-beat="0.07 0.2">
        <span class="lab">01 · A song</span>
        <h2>Every song has a shape.</h2>
        <p>Drawn from its recipe, the same on every phone, before the song has even finished being made. This one is “{HERO}”.</p>
      </div>
      <div class="beat words" data-beat="0.2 0.36">
        <span class="lab">02 · A library</span>
        <h2>Together, they make a map.</h2>
        <p>The songs your node makes and the music already on your phone, gathered by when they arrived, in one field. A song with a hole is one you owned before.</p>
      </div>
      <div class="beat words" data-beat="0.36 0.45">
        <span class="lab">03 · Where it is</span>
        <h2>The ink says where.</h2>
        <ul class="legend">
          <li><svg viewBox="-10 -10 20 20"><path d={facePathAt(madeRecipe, 0, 0, 8)} class="l-remote" /></svg>Still on your node</li>
          <li><svg viewBox="-10 -10 20 20"><path d={facePathAt(madeRecipe, 0, 0, 8)} class="l-cached" /></svg>Cached on your phone</li>
          <li><svg viewBox="-10 -10 20 20"><path d={facePathAt(madeRecipe, 0, 0, 8)} class="l-down" /></svg>Kept: plays on a plane</li>
          <li><svg viewBox="-10 -10 20 20"><path d={facePathAt(importedRecipe, 0, 0, 8) + 'M1.6 0a1.6 1.6 0 1 0 -3.2 0a1.6 1.6 0 1 0 3.2 0Z'} class="l-down" fill-rule="evenodd" /></svg>Your own file</li>
        </ul>
      </div>
      <div class="beat words" data-beat="0.46 0.61">
        <span class="lab">04 · Another lens</span>
        <h2>The seal.</h2>
        <p>Each dot a moment of the song, threaded in the order it plays. They leave the circle where their moment stands on its clock.</p>
      </div>
      <div class="beat words" data-beat="0.63 0.8">
        <span class="lab">05 · And another</span>
        <h2>Marbling.</h2>
        <p>Drops of ink and clear water, combed, the way paper has been marbled for centuries. Nothing is erased: every song keeps its own bath.</p>
      </div>
      <div class="beat words dive-words" data-beat="0.84 0.97">
        <span class="lab">06 · Yours</span>
        <h2>Made on a machine you own.</h2>
      </div>

      <div class="night" data-night aria-hidden="true"></div>
      <div class="progress" aria-hidden="true"><i data-field-progress></i></div>
    </div>
  </section>

  <!-- ===== privacy: pinned, in ink ===== -->
  <section class="stage inverse privacy" id="privacy" data-stage="privacy">
    <div class="pin">
      <div class="beat words" data-beat="0 0.34">
        <span class="lab">07 · No account</span>
        <h2>Nothing to sign in to.</h2>
        <p>Your identity is twelve words your phone makes for itself. No email, no password, nothing of yours on our side.</p>
      </div>
      <ol class="phrase beat" data-beat="0.02 0.34">
        {words.map((w, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{w}</li>)}
      </ol>

      <div class="beat words" data-beat="0.36 0.82">
        <span class="lab" data-cipher-label>08 · What your node reads</span>
        <h2>Sealed, end to end.</h2>
        <p>Between your phone and your node, everything is encrypted. The relay that joins them carries bytes it cannot open: it sees that two devices talk, never what they say.</p>
      </div>
      <p class="cipher beat" data-beat="0.36 0.82" data-cipher={PROMPT} aria-label={`"${PROMPT}", encrypted as the relay sees it`}>{PROMPT}</p>

      <div class="beat facts-beat" data-beat="0.82 1.01">
        <dl class="facts">
          <div><dt>Keys, not passwords</dt><dd>Ed25519 on both sides, pinned the moment you pair. The node proves itself before your phone says a word.</dd></div>
          <div><dt>Noise, every time</dt><dd>A fresh handshake on every connection, and no plaintext fallback. Ever.</dd></div>
          <div><dt>Nothing reported</dt><dd>The node sends us nothing. The app's one other call fetches lyrics for your own files from LRCLIB, which learns a title and an artist, never audio.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ===== sharing: pinned ===== -->
  <section class="stage network" id="network" data-stage="network">
    <div class="pin">
      <div class="beat words" data-beat="0 0.42">
        <span class="lab">09 · Your compute</span>
        <h2>One machine, a whole household.</h2>
        <p>The computer with the GPU makes the songs. Pair your phone with it, then your friends' phones.</p>
      </div>
      <div class="beat words" data-beat="0.42 0.72">
        <span class="lab">10 · Apart</span>
        <h2>Everyone keeps their own.</h2>
        <p>Each phone gets a library of its own on the node, which nobody else sees. The node makes one song at a time, and nobody can fill the queue.</p>
      </div>
      <div class="beat words" data-beat="0.72 1.01">
        <span class="lab">11 · And back</span>
        <h2>One phone, many nodes.</h2>
        <p>Your phone can pair with more than one: the desktop at home, the laptop on the road. Revoke any of them whenever you like.</p>
      </div>

      <figure class="net" aria-label="Four phones pair with one desktop node, one after another; one phone also pairs with a laptop">
        <svg class="wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {PHONES.flatMap((p) => p.to.map(([t, step]) => {
            const n = at(t);
            return <line x1={p.x} y1={p.y} x2={n.x} y2={n.y} data-step={step} />;
          }))}
        </svg>
        {NODES.map((n) => (
          <div class:list={['node', { big: n.big }]} style={`left:${n.x}%;top:${n.y}%`} data-step={n.step}>
            <Station publicKey={n.key} models={n.models} />
            <span>{n.label}</span>
          </div>
        ))}
        {PHONES.map((p) => (
          <div class="person" style={`left:${p.x}%;top:${p.y}%`} data-step={p.to[0][1]}>
            <Phone publicKey={p.key} />
            <span>{p.label}</span>
            <svg class="own" viewBox="-30 -10 60 20" aria-hidden="true">
              {shelf(p.key).map((r, i) => <path d={facePathAt(r, -18 + i * 18, 0, 7)} />)}
            </svg>
          </div>
        ))}
      </figure>
    </div>
  </section>

  <!-- ===== the source ===== -->
  <section class="source" id="source">
    <div class="inner">
      <header class="split">
        <div>
          <span class="lab">12 · Open source</span>
          <h2>Read every line.</h2>
        </div>
        <p>Cantor is Apache-2.0, all of it. You do not have to take our word for anything on this page: the app, the node, the relay and the wire format they share are in one repository.</p>
      </header>
      <ul class="tree">
        <li><a href={`${SITE.github}/tree/main/cantor`}>cantor/</a><span>The Android app: the field, the lenses, the player</span></li>
        <li><a href={`${SITE.github}/tree/main/node`}>node/</a><span>The node, in Rust: models, generation, your library</span></li>
        <li><a href={`${SITE.github}/tree/main/relay`}>relay/</a><span>The relay: a Cloudflare Worker that splices sealed bytes</span></li>
        <li><a href={`${SITE.github}/tree/main/protocol`}>protocol/</a><span>The wire contract, its fixtures, and its generated types</span></li>
        <li><a href={`${SITE.github}/tree/main/contributing`}>contributing/</a><span>How it fits together, and how to change it</span></li>
      </ul>
    </div>
  </section>

  <!-- ===== begin ===== -->
  <section class="inverse begin" id="begin">
    <div class="inner">
      <h2>Begin</h2>
      <div class="two">
        <div class="side">
          <span class="lab">On your phone</span>
          <a class="btn" href={SITE.apk}>Download for Android</a>
          <p>An APK for Android 7 and later.</p>
        </div>
        <div class="side">
          <span class="lab">On your computer</span>
          <CopyLine text={SITE.install} />
          <p>Then <code>cantor pull</code> a model and <code>cantor pair</code> your phone. The installer offers both.</p>
        </div>
      </div>
      <dl class="needs">
        <div><dt>A computer that stays on</dt><dd>Linux or macOS. A GPU makes it quick; a CPU is enough, only slower.</dd></div>
        <div><dt>Room for a model</dt><dd>From about 3 GB for a first model, up to 27 GB for the largest.</dd></div>
        <div><dt>Open models</dt><dd>Good, and yours. Each comes with its own licence, shown before it downloads.</dd></div>
      </dl>
      <a class="more" href="/docs/start/">The quick start, step by step</a>
    </div>
  </section>

  <footer>
    <span class="brand"><Seal name={NAME} depth={2} filled class="brand-seal" />Cantor · alpha</span>
    <span><a href="/docs/">Docs</a><a href={SITE.github}>Source</a><span>Apache-2.0</span></span>
  </footer>
</Site>

<script>
  import Lenis from 'lenis';
  import { startFieldStage } from '../scripts/field-stage';

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));

  // Smooth, weighted scrolling; native scrolling when motion is reduced.
  if (!still) new Lenis({ autoRaf: true, lerp: 0.09, anchors: true });

  /** How far through its pinned run a stage is, 0 to 1. */
  const progressOf = (stage: HTMLElement) => {
    const r = stage.getBoundingClientRect();
    return clamp(-r.top / Math.max(1, r.height - innerHeight));
  };

  /** Show each beat in its window, rising in and lifting out. */
  const beats = (stage: HTMLElement, p: number) => {
    for (const beat of stage.querySelectorAll<HTMLElement>('[data-beat]')) {
      const [a, b] = beat.dataset.beat!.split(' ').map(Number);
      const fade = 0.025;
      const inn = a === 0 ? 1 : clamp((p - a) / fade);
      const out = b > 1 ? 1 : clamp((b - p) / fade);
      const o = Math.min(inn, out);
      beat.style.opacity = String(o);
      beat.style.translate = `0 ${(1 - inn) * 28 - (1 - out) * 28}px`;
      beat.style.visibility = o > 0.001 ? 'visible' : 'hidden';
    }
  };

  // ---- the field
  const field = document.querySelector<HTMLElement>('[data-stage="field"]')!;
  const night = field.querySelector<HTMLElement>('[data-night]')!;
  const bar = field.querySelector<HTMLElement>('[data-field-progress]')!;
  startFieldStage(field.querySelector('[data-field-canvas]')!, field, 'an empty ballroom', (p) => {
    beats(field, p);
    night.style.opacity = String(clamp((p - 0.93) / 0.07));
    bar.style.transform = `scaleX(${p})`;
  });

  // ---- privacy: the prompt dissolves into what the relay sees
  const privacy = document.querySelector<HTMLElement>('[data-stage="privacy"]')!;
  const cipher = privacy.querySelector<HTMLElement>('[data-cipher]')!;
  const label = privacy.querySelector<HTMLElement>('[data-cipher-label]')!;
  const text = cipher.dataset.cipher!;
  cipher.textContent = '';
  const HEX = '0123456789abcdef';
  const letters = [...text].map((ch, i) => {
    const span = document.createElement('span');
    span.textContent = ch;
    span.dataset.plain = ch;
    span.dataset.sealed = ch === ' ' ? ' ' : HEX[(i * 7 + ch.charCodeAt(0) * 13) % 16];
    cipher.appendChild(span);
    return span;
  });
  const sealAt = (p: number) => clamp((p - 0.46) / 0.26);

  // ---- sharing: people pair, one after another
  const network = document.querySelector<HTMLElement>('[data-stage="network"]')!;
  const steps = [...network.querySelectorAll<HTMLElement | SVGElement>('[data-step]')];
  const stepAt = (p: number) => (p < 0.08 ? 0 : p < 0.72 ? 1 + Math.floor(((p - 0.08) / 0.64) * 4) : 5);

  const frame = () => {
    requestAnimationFrame(frame);
    const pp = progressOf(privacy);
    beats(privacy, pp);
    const k = Math.round(sealAt(pp) * letters.length);
    letters.forEach((s, i) => {
      const sealed = i < k;
      if (s.classList.contains('sealed') !== sealed) {
        s.classList.toggle('sealed', sealed);
        s.textContent = sealed ? s.dataset.sealed! : s.dataset.plain!;
      }
    });
    label.textContent = k >= letters.length * 0.5 ? '08 · What the relay sees' : '08 · What your node reads';

    const np = progressOf(network);
    beats(network, np);
    const step = stepAt(np);
    for (const el of steps) el.classList.toggle('on', Number(el.dataset.step) <= step);
    network.classList.toggle('apart', np > 0.42);
  };
  requestAnimationFrame(frame);

  // ---- the bar and the rail
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-chapter]')];
  const chrome = () => {
    const onInk = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      return r.top < 32 && r.bottom > 32;
    };
    const fieldR = field.getBoundingClientRect();
    const dark = onInk(privacy) || onInk(document.getElementById('begin')!) || (fieldR.bottom > 32 && progressOf(field) > 0.95);
    nav.classList.toggle('on-ink', dark);
    nav.classList.toggle('solid', !dark && !(fieldR.top <= 0 && fieldR.bottom > innerHeight) && !onInk(network));
    let current = links[0];
    for (const a of links) {
      const target = document.getElementById(a.dataset.chapter!);
      if (target && target.getBoundingClientRect().top < innerHeight * 0.5) current = a;
    }
    for (const a of links) a.classList.toggle('on', a === current);
    requestAnimationFrame(chrome);
  };
  requestAnimationFrame(chrome);
</script>

<style is:global>
  html.lenis, html.lenis body { height: auto; }
  .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
</style>

<style>
  .inner { max-width: 1240px; margin: 0 auto; }
  section { padding: 160px 40px; }
  h2 { font: 400 clamp(40px, 4.6vw, 68px) / 1.02 var(--display); margin: 0; letter-spacing: -0.5px; text-wrap: balance; }
  p { font-size: 19px; line-height: 31px; margin: 0; text-wrap: pretty; }
  .lab { display: block; font: 10.5px/1 var(--mono); letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin-bottom: 22px; }
  .more { display: inline-block; font: 11px/1 var(--mono); letter-spacing: 2px; text-transform: uppercase; text-decoration: none; padding-bottom: 5px; border-bottom: 1px solid currentColor; }
  code { font-size: 0.86em; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 60px; align-items: end; margin-bottom: 88px; }
  .split p { color: var(--muted); max-width: 46ch; }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; margin: 0; border-top: 1px solid var(--ink); }
  .facts div { padding-top: 22px; }
  .facts dt { font: 10.5px/1 var(--mono); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 14px; }
  .facts dd { margin: 0; font-size: 16.5px; line-height: 26px; color: var(--muted); max-width: 34ch; }

  /* ---- the bar and the rail ----------------------------------------------- */
  .top { position: fixed; z-index: 6; inset: 0 0 auto; height: 64px; display: flex; justify-content: space-between; align-items: center; padding: 0 40px;
    font: 11px/1 var(--mono); letter-spacing: 2.4px; text-transform: uppercase; color: var(--ink);
    border-bottom: 1px solid transparent; transition: background-color 0.3s linear, border-color 0.3s linear, color 0.3s linear; }
  .top.solid { background: var(--paper); border-bottom-color: var(--line); }
  .top.on-ink { background: transparent; border-bottom-color: transparent; color: var(--paper); }
  .top.on-ink .links a { color: inherit; opacity: 0.7; }
  .top.on-ink .links .get { border-color: currentColor; opacity: 1; }
  .top a { text-decoration: none; }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand :global(.brand-seal) { width: 19px; height: 19px; --seal-ink: currentColor; }
  .links a { margin-left: 28px; color: var(--muted); transition: color 0.2s linear; }
  .links a:hover { color: var(--ink); }
  .links .get { color: var(--ink); border-bottom: 1px solid var(--ink); padding-bottom: 4px; }

  .rail { position: fixed; z-index: 5; right: 40px; top: 50%; transform: translateY(-50%); list-style: none; margin: 0; padding: 0 0 0 16px;
    border-left: 1px solid #808080; display: grid; gap: 18px; mix-blend-mode: difference; }
  .rail a { display: block; font: 10px/1 var(--mono); letter-spacing: 1.8px; text-transform: uppercase; text-decoration: none; color: #fff; opacity: 0.4; transition: opacity 0.3s linear; position: relative; }
  .rail a.on { opacity: 1; }
  .rail a.on::before { content: ''; position: absolute; left: -17px; top: -4px; bottom: -4px; width: 1px; background: #fff; }

  /* ---- a pinned stage --------------------------------------------------------- */
  .stage { padding: 0; position: relative; }
  .pin { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .field { height: 820vh; }
  .privacy { height: 360vh; }
  .network { height: 380vh; }
  .canvas { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--ink); }
  .beat { position: absolute; will-change: opacity, translate; }
  .words { left: 40px; top: 50%; translate: 0 0; margin-top: -150px; width: min(30vw, 440px); min-width: 340px; }
  .words p { color: var(--muted); margin-top: 26px; max-width: 34ch; }
  .words h2 { max-width: 12ch; }

  .hero-beat { left: 40px; bottom: 48px; }
  h1 { font: 400 clamp(96px, 15.5vw, 240px) / 0.8 var(--display); margin: 0 0 0 -0.04em; letter-spacing: -0.02em; }
  .hero-beat p { font: 400 clamp(20px, 1.9vw, 27px) / 1.3 var(--display); color: var(--muted); margin: 28px 0 0; }
  /* The intro: the title's letters rise one after another, then the line. */
  h1 span { display: inline-block; animation: rise 1.1s cubic-bezier(.2, .7, .1, 1) both; animation-delay: calc(0.35s + var(--i) * 0.07s); }
  .rise { animation: rise 1.1s cubic-bezier(.2, .7, .1, 1) 0.9s both; }
  .hero-card { animation: fade 1s linear 1.4s both; }
  @keyframes rise { from { opacity: 0; transform: translateY(0.45em); } to { opacity: 1; transform: none; } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { h1 span, .rise, .hero-card { animation: none; } }
  .tip { position: absolute; left: 0; top: 0; z-index: 3; pointer-events: none; display: grid; gap: 6px; padding: 10px 12px; background: var(--paper); border: 1px solid var(--ink); }
  .tip[hidden] { display: none; }
  .tip i { font: italic 400 16px/1.2 var(--display); }
  .tip span { font: 10px/1 var(--mono); letter-spacing: 1.4px; text-transform: uppercase; color: var(--muted); }
