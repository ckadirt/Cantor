---
/**
 * cantorfm.com. The art leads and the words are its labels: the site's own
 * name marbled as you watch, what Cantor is in one sentence, one song in the
 * app's three lenses, the two marks that pair, and how to begin.
 */
import Site from '../layouts/Site.astro';
import Seal from '../components/art/Seal.astro';
import Face from '../components/art/Face.astro';
import Marbling from '../components/art/Marbling.astro';
import Station from '../components/art/Station.astro';
import Phone from '../components/art/Phone.astro';
import CopyLine from '../components/CopyLine.astro';
import { SITE } from '../site';

const NAME = 'cantorfm.com';
/** The song the lenses draw: any recipe would do; this one reads well. */
const SONG = 'an empty ballroom';
---
<Site title="Cantor — songs made on your own machine" description="Cantor writes songs on a computer you own and plays them on your phone. Nothing in between can listen.">
  <nav class="top" data-nav>
    <a class="brand" href="/"><Seal name={NAME} depth={2} filled class="brand-seal" /><span>Cantor</span></a>
    <span class="links">
      <a href="/docs/">Docs</a>
      <a href={SITE.github}>Source</a>
      <a href="#begin" class="get">Get Cantor</a>
    </span>
  </nav>

  <header class="hero">
    <Marbling name={NAME} live fit={1.9} cx={0.68} cy={0.48} class="bath" label="This site's name, marbled one drop at a time" />
    <div class="title">
      <h1>Cantor</h1>
      <p>Songs made on your own machine,<br />heard on your phone.</p>
    </div>
    <aside class="plate-card">
      <span>Plate I</span>
      <i>cantorfm.com, marbled</i>
      <span>A drop of ink for every bar · bar <b data-bar-for={NAME}>0</b></span>
    </aside>
  </header>

  <section class="statement">
    <p class="big">Cantor writes songs on a computer you own, and plays them on your phone. Nothing in between can listen.</p>
    <dl class="facts">
      <div>
        <dt>On your machine</dt>
        <dd>The models, the songs and your library. Linux or macOS; a GPU makes it quick, a CPU is enough.</dd>
      </div>
      <div>
        <dt>On your phone</dt>
        <dd>Every song you have, drawn from its own recipe. Ask for a new one, a version, a longer one, or one that starts from your humming.</dd>
      </div>
      <div>
        <dt>In between</dt>
        <dd>A relay that splices sealed bytes. It sees that two devices talk, never a prompt, a title or a note.</dd>
      </div>
    </dl>
  </section>

  <section class="inverse lenses">
    <div class="inner">
      <header>
        <h2>A song is known by its shape</h2>
        <p>Every song is drawn from its own recipe, three ways. The same song is the same shape on every phone, so you know it before you read its name.</p>
      </header>
      <div class="three">
        <figure>
          <div class="art"><Face name={SONG} class="face" /></div>
          <figcaption><i>The circle</i>One contour: its lobes, its turn, its length.</figcaption>
        </figure>
        <figure>
          <div class="art"><Seal name={SONG} depth={3} played={0} class="looping" /></div>
          <figcaption><i>The seal</i>Each dot a moment of the song, inked as it plays.</figcaption>
        </figure>
        <figure>
          <div class="art"><Marbling name={SONG} class="marble" /></div>
          <figcaption><i>The marbling</i>Drops of ink and clear water, combed. Nothing is erased.</figcaption>
        </figure>
      </div>
      <p class="recipe">“{SONG}”</p>
    </div>
  </section>

  <section class="pairing">
    <div class="inner">
      <div class="words">
        <h2>Two marks, one secret</h2>
        <p>Your phone has a seal and your node a station, each drawn from its own key. Pairing is the two of them agreeing, once. After that every word between them is sealed end to end.</p>
        <a class="more" href="/docs/start/#pair-your-phone">How pairing works</a>
      </div>
      <figure class="pair">
        <div class="mark"><Phone publicKey="your phone" /><span>Your phone</span></div>
        <svg class="wires" viewBox="0 0 400 160" preserveAspectRatio="none" aria-hidden="true">
          <path class="to" d="M0 80 C 110 8, 290 8, 400 80" />
          <path class="from" d="M400 80 C 290 152, 110 152, 0 80" />
        </svg>
        <div class="mark"><Station publicKey="your node" models={3} /><span>Your node</span></div>
        <figcaption>The relay<br /><em>sealed bytes, both ways</em></figcaption>
      </figure>
    </div>
  </section>

  <section class="inverse begin" id="begin">
    <div class="inner">
      <h2>Begin</h2>
      <div class="two">
        <div class="side">
          <span class="lab">On your phone</span>
          <a class="btn" href={SITE.apk}>Download for Android</a>
          <p>An APK for Android 7 and later.</p>
        </div>
        <div class="side">
          <span class="lab">On your computer</span>
          <CopyLine text={SITE.install} />
          <p>Then <code>cantor pull</code> a model and <code>cantor pair</code> your phone. The installer offers both.</p>
        </div>
      </div>
      <a class="more" href="/docs/start/">The quick start, step by step</a>
    </div>
  </section>

  <footer>
    <span class="brand"><Seal name={NAME} depth={2} filled class="brand-seal" />Cantor · alpha</span>
    <span><a href="/docs/">Docs</a><a href={SITE.github}>Source</a><span>Apache-2.0</span></span>
  </footer>
</Site>

<script>
  // The bar turns solid once the hero is behind it, so it never sits on text.
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const hero = document.querySelector('.hero')!;
  new IntersectionObserver(([entry]) => nav.classList.toggle('solid', !entry.isIntersecting), {
    rootMargin: '-64px 0px 0px 0px',
  }).observe(hero);

  // The seal plays its song: one dot after another on a linear clock, a rest
  // when it is all ink, then again. Still when motion is reduced.
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const seal of document.querySelectorAll<SVGElement>('svg.looping')) {
    const dots = [...seal.querySelectorAll<SVGCircleElement>('circle')];
    const count = dots.length;
    if (still) {
      dots.forEach((d) => d.classList.add('on'));
      continue;
    }
    const PLAY = 14000;
    const REST = 2400;
    let shown = -1;
    let visible = false;
    const start = performance.now();
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(seal);
    const frame = (now: number) => {
      requestAnimationFrame(frame);
      if (!visible) return;
      const t = (now - start) % (PLAY + REST);
      const sounded = Math.min(count, Math.floor((t / PLAY) * count));
      if (sounded === shown) return;
      shown = sounded;
      for (const d of dots) d.classList.toggle('on', Number(d.dataset.k) < sounded);
    };
    requestAnimationFrame(frame);
  }
</script>

<style>
  .inner { max-width: 1240px; margin: 0 auto; }
  section { padding: 160px 40px; }
  h2 { font: 400 clamp(38px, 4.2vw, 60px) / 1.05 var(--display); margin: 0; letter-spacing: -0.4px; text-wrap: balance; }
  p { font-size: 19px; line-height: 31px; margin: 0; text-wrap: pretty; }
  .more { display: inline-block; font: 11px/1 var(--mono); letter-spacing: 2px; text-transform: uppercase; text-decoration: none; padding-bottom: 5px; border-bottom: 1px solid currentColor; }

  /* ---- the bar ------------------------------------------------------------ */
  .top { position: fixed; z-index: 5; inset: 0 0 auto; height: 64px; display: flex; justify-content: space-between; align-items: center; padding: 0 40px;
    font: 11px/1 var(--mono); letter-spacing: 2.4px; text-transform: uppercase; color: var(--ink);
    border-bottom: 1px solid transparent; transition: background-color 0.3s linear, border-color 0.3s linear; }
  .top.solid { background: var(--paper); border-bottom-color: var(--line); }
  .top a { text-decoration: none; }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand :global(.brand-seal) { width: 19px; height: 19px; --seal-ink: currentColor; }
  .links a { margin-left: 28px; color: var(--muted); transition: color 0.2s linear; }
  .links a:hover { color: var(--ink); }
  .links .get { color: var(--ink); border-bottom: 1px solid var(--ink); padding-bottom: 4px; }

  /* ---- the hero ------------------------------------------------------------- */
  .hero { position: relative; height: 100svh; min-height: 640px; overflow: hidden; }
  .hero :global(.bath) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .title { position: absolute; left: 40px; bottom: 48px; }
  h1 { font: 400 clamp(96px, 15.5vw, 240px) / 0.8 var(--display); margin: 0 0 0 -0.04em; letter-spacing: -0.02em; }
  .title p { font: 400 clamp(20px, 1.9vw, 27px) / 1.3 var(--display); color: var(--muted); margin: 28px 0 0; }
  .plate-card { position: absolute; right: 40px; bottom: 52px; display: grid; justify-items: end; gap: 7px; text-align: right;
    font: 10px/1.4 var(--mono); letter-spacing: 1.6px; text-transform: uppercase; color: var(--muted); }
  .plate-card i { font: italic 400 17px/1.2 var(--display); letter-spacing: 0; text-transform: none; color: var(--ink); }
  .plate-card b { font-weight: 400; color: var(--ink); font-variant-numeric: tabular-nums; }

  /* ---- what it is ------------------------------------------------------------ */
  .statement { max-width: 1320px; margin: 0 auto; padding-top: 180px; }
  .big { font: 400 clamp(32px, 3.4vw, 50px) / 1.18 var(--display); letter-spacing: -0.2px; max-width: 27ch; text-wrap: balance; }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; margin: 96px 0 0; border-top: 1px solid var(--ink); }
  .facts div { padding-top: 22px; }
  .facts dt { font: 10.5px/1 var(--mono); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 14px; }
  .facts dd { margin: 0; font-size: 17px; line-height: 27px; color: var(--muted); max-width: 34ch; }

  /* ---- the lenses ------------------------------------------------------------ */
  .lenses header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 60px; align-items: end; margin-bottom: 100px; }
  .lenses header p { color: var(--muted); max-width: 44ch; }
  .three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; }
  .three figure { margin: 0; }
  .art { aspect-ratio: 1 / 1; display: grid; place-items: center; }
  .art :global(.face) { width: 78%; height: 78%; }
  .art :global(.face path) { stroke-width: 1.4px; }
  .art :global(.looping) { width: 66%; height: 66%; }
  .art :global(.marble) { width: 74%; height: 74%; }
  .three figcaption { margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--line); font-size: 15.5px; line-height: 24px; color: var(--muted); max-width: 30ch; }
  .three figcaption i { display: block; font: italic 400 22px/1.2 var(--display); color: var(--ink); margin-bottom: 6px; }
  .recipe { margin-top: 72px; text-align: center; font: italic 400 20px/1 var(--display); color: var(--muted); }

  /* ---- pairing --------------------------------------------------------------- */
  .pairing .inner { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 80px; align-items: center; }
  .pairing .words p { color: var(--muted); margin: 24px 0 34px; max-width: 40ch; }
  .pair { margin: 0; display: grid; grid-template-columns: 120px minmax(0, 1fr) 120px; align-items: center; position: relative; }
  .mark { display: grid; justify-items: center; gap: 18px; }
  .mark :global(svg) { width: 104px; height: 104px; }
  .mark span { white-space: nowrap; font: 10px/1 var(--mono); letter-spacing: 2px; text-transform: uppercase; color: var(--muted); }
  .wires { width: 100%; height: 160px; margin-bottom: 34px; }
  .wires path { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-dasharray: 0 11; vector-effect: non-scaling-stroke; animation: flow 1.6s linear infinite; }
  .wires .from { opacity: 0.45; }
  @keyframes flow { to { stroke-dashoffset: -11; } }
  .pair figcaption { position: absolute; left: 50%; top: calc(50% - 17px); transform: translate(-50%, -50%); text-align: center; background: var(--paper); padding: 6px 12px;
    font: 10px/1.6 var(--mono); letter-spacing: 2px; text-transform: uppercase; }
  .pair figcaption em { font: italic 400 14px/1.4 var(--display); letter-spacing: 0; text-transform: none; color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .wires path { animation: none; } }

  /* ---- begin ----------------------------------------------------------------- */
  .begin h2 { font-size: clamp(64px, 8vw, 128px); line-height: 0.9; letter-spacing: -1px; margin-bottom: 80px; }
  .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; border-top: 1px solid var(--ink); }
  .side { padding: 28px 48px 8px 0; display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: 22px; min-width: 0; }
  .side + .side { padding-left: 48px; border-left: 1px solid var(--line); }
  .lab { font: 10.5px/1 var(--mono); letter-spacing: 2px; text-transform: uppercase; color: var(--muted); }
  .btn { justify-self: start; font: 400 24px/1 var(--display); padding: 20px 30px; background: var(--ink); color: var(--paper); text-decoration: none; transition: opacity 0.2s linear; }
  .btn:hover { opacity: 0.85; }
  .side p { font-size: 15.5px; line-height: 24px; color: var(--muted); }
  .side code { font-size: 13.5px; color: var(--ink); }
  .begin .more { margin-top: 64px; }

  footer { display: flex; justify-content: space-between; align-items: center; padding: 26px 40px; font: 10.5px/1 var(--mono); letter-spacing: 1.8px; text-transform: uppercase; color: var(--muted); }
  footer a, footer span span { margin-left: 24px; text-decoration: none; }
  footer a:hover { color: var(--ink); }

  @media (max-width: 900px) {
    section { padding: 110px 22px; }
    .top { padding: 0 22px; }
    .links a { margin-left: 18px; }
    .links a:not(.get) { display: none; }
    .title { left: 22px; bottom: 40px; }
    .plate-card { display: none; }
    .statement { padding-top: 120px; }
    .facts, .three { grid-template-columns: 1fr; gap: 36px; }
    .facts { margin-top: 64px; }
    .lenses header, .pairing .inner { grid-template-columns: 1fr; gap: 28px; }
    .lenses header { margin-bottom: 56px; }
    .art :global(.face), .art :global(.looping), .art :global(.marble) { width: 64%; height: 64%; }
    .pair { grid-template-columns: 84px minmax(0, 1fr) 84px; }
    .mark span { letter-spacing: 1.2px; }
    .mark :global(svg) { width: 64px; height: 64px; }
    .wires { height: 110px; margin-bottom: 30px; }
    .pair figcaption { position: static; transform: none; grid-column: 1 / -1; margin-top: 28px; background: none; padding: 0; }
    .two { grid-template-columns: minmax(0, 1fr); }
    .side { padding-right: 0; }
    .side + .side { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); margin-top: 28px; }
    .begin h2 { margin-bottom: 48px; }
    footer { flex-direction: column; gap: 16px; align-items: flex-start; }
    footer a:first-child { margin-left: 0; }
  }
</style>
