---
/** A phone's mark: spokes from its key round a dot. */
import { phoneMark } from '../../lib/art';

interface Props { publicKey: string; class?: string }
const { publicKey, class: className } = Astro.props;
const spokes = phoneMark(publicKey);
---
<svg class:list={['phone', className]} viewBox="-1.1 -1.1 2.2 2.2" aria-hidden="true">
  {spokes.map((s) => <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke="currentColor" stroke-width="1.2" vector-effect="non-scaling-stroke" stroke-linecap="round" />)}
  <circle cx="0" cy="0" r="0.09" fill="currentColor" />
</svg>
