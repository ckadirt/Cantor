---
/** A page's circle: one contour drawn from its recipe. */
import { facePath } from '../../lib/art';

interface Props { name: string; class?: string }
const { name, class: className } = Astro.props;
---
<svg class:list={['face', className]} viewBox="-1.05 -1.05 2.1 2.1" aria-hidden="true">
  <path d={facePath(name)} fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
</svg>
