---
/**
 * The page's coda: a double bar, then the one act a page has, the next page,
 * drawn with its seal. The previous page waits quietly beside it.
 */
import Seal from '../art/Seal.astro';

const { pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
---
{
  (prev || next) && (
    <nav class="coda print:hidden" aria-label="Next and previous pages">
      {next ? (
        <a class="act" href={next.href} rel="next">
          <span class="lab">Next</span>
          <span class="title">{next.label}</span>
          <Seal name={next.label} depth={2} class="next-seal" />
        </a>
      ) : <span />}
      {prev && (
        <a class="back" href={prev.href} rel="prev">
          <span class="lab">Back</span> {prev.label}
        </a>
      )}
    </nav>
  )
}
<style>
  .coda { position: relative; margin-top: 3.5rem; padding-inline-start: 2.75rem; display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap; }
  .coda::before { content: ''; position: absolute; inset-inline-start: 0; top: 0; width: 5px; height: 3.5rem; border-inline-start: 1px solid var(--ink); border-inline-end: 3px solid var(--ink); }
  .act { display: grid; grid-template-columns: auto auto; grid-template-rows: auto auto; column-gap: 1.25rem; align-items: end; text-decoration: none; color: var(--ink); }
  .act .lab { grid-column: 1; font: 400 0.6875rem/1 var(--mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.6rem; }
  .act .title { grid-column: 1; grid-row: 2; font: 400 1.875rem/1.1 var(--display); padding-bottom: 0.35rem; border-bottom: 1px solid var(--ink); }
  .act :global(.next-seal) { grid-column: 2; grid-row: 1 / span 2; width: 3.25rem; height: 3.25rem; }
  .back { font-size: 0.95rem; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--ink); }
  .back .lab { font: 400 0.6875rem/1 var(--mono); letter-spacing: 0.16em; text-transform: uppercase; margin-inline-end: 0.5rem; }
</style>
